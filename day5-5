
#include<iostream>
using namespace std;

int main(){
    int N;
    int i, j;
    int count = 0;
    int flag;

    cout << "Enter N: ";
    cin >> N;

    for (i = 2; ; i++){
        flag = 0;

        for (j = 2; j < i; j++){
            if (i % j == 0){
                flag = 1;
                break;
            }
        }

        if (flag == 0){
            count++;
        }

        if (count == N){
            cout << "Nth Prime Number = " << i;
            break;
        }
    }

    return 0;
}
