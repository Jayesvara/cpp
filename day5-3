
#include<iostream>
using namespace std;

int main(){
    int N;
    int i;
    int sum = 0;

    cout << "Enter a number: ";
    cin >> N;

    for (i = 1; i < N; i++){
        if (N % i == 0){
            sum = sum + i;
        }
    }

    if (sum == N){
        cout << "Perfect Number";
    }
    else{
        cout << "Not a Perfect Number";
    }

    return 0;
}
